    func => \&to_roman,
  },
  'from_roman' => {
    sig  => 'from_roman($s)',
    desc => 'Convert a Roman numeral between I and MMMCMXCIX to an integer',
    func => \&from_roman,
  },
);


# Get the utility function with the given name.
sub utils_get {
  my ($name) = @_;
  die "Unknown utility function: $name" unless exists $UTIL_FUNCTIONS{$name};
  return $UTIL_FUNCTIONS{$name}{func};
}


# Install the named utility functions into the expression package. Functions
# that were not selected never enter it, so the namespace the expressions see
# stays limited to what was asked for.
sub utils_install {
  my (@names) = @_;
  no strict 'refs'; ## no critic (ProhibitNoStrict)
  for my $name (@names) {
    *{"${EVAL_PACKAGE}::$name"} = utils_get($name);
  }
  return;
} ## end sub utils_install


# List all available utility functions.
sub utils_list {
  binmode STDOUT, ':encoding(utf-8)';
  say q{The following utility functions are available:};
  say q{};
  my $colwidth = max map { length $UTIL_FUNCTIONS{$_}{sig} } keys %UTIL_FUNCTIONS;
  for my $name ( sort keys %UTIL_FUNCTIONS ) {
    my ( $sig, $desc ) = @{ $UTIL_FUNCTIONS{$name} }{qw{ sig desc }};
    printf "  %s %s %s\n", $sig, q{ } x ( $colwidth - length $sig ), $desc;
  }
  say q{};
  return;
} ## end sub utils_list


# Transform filenames using the provided expressions.
sub transform_names {
  my ($params)  = @_;
  my $old_names = $params->{files};
  my $new_names = [ map { transform_name( $params, $_ ) } @{$old_names} ];
  check_hard_collisions( $old_names, $new_names ) if $params->{check_collisions};
  return dodge_soft_collisions( $old_names, $new_names );
} ## end sub transform_names


# Run a step that may throw, dying with a contextual message on failure.
# The block performs its side effect (e.g. assigns to a captured variable);
# its return value is ignored, so falsy results are not mistaken for errors.
sub try_step {
  my ( $code, $errmsg ) = @_;
  my $ok = do {
    local $SIG{__DIE__} = 'DEFAULT';                # Wrap the raw failure, not a rendered one.
    eval { $code->(); 1 }; ## no critic (RequireCheckingReturnValueOfEval)
  };
  $ok or die "$errmsg: $EVAL_ERROR";
  return;
} ## end sub try_step


# Transform a filename using the provided expressions.
# Handles basename, extension, and character encoding based on parameters.
sub transform_name {
  my ( $params, $name ) = @_;

  # Split the filename into its components based on parameters
  my ( $dir, $subj, $ext ) = ( q{}, $name, q{} );

  # Handle basename - isolate directory if needed
  if ( $params->{basename} ) {
    ( $dir, $subj ) = $subj =~ m{ \A ( | .* / ) ( [^/]+ /? ) \z }msx
      or die "Failed to isolate basename from '$name'\n";
  }

  # Handle extension - isolate extension if needed
  if ( $params->{exclude_ext} ) {
    ( $subj, $ext ) = $subj =~ m{ \A
      ( .+? )
      ( /? | \.[[:alnum:]]+ (?: \.[gx]z | \.p?bz2 | \.lz(?:|[4o]|ma) | \.zstd? )? /? )
    \z }msx
      or die "Failed to isolate extension from '$subj'\n";
  } ## end if ( $params->{exclude_ext...})

  # Decode, transform, and re-encode the filename.
  try_step( sub { $subj = $params->{from_charset}{codec}->decode($subj) },
    "Failed to decode '$subj' from $params->{from_charset}{name}" );

  # Apply each expression in sequence.
  foreach my $expr ( @{ $params->{exprs} } ) {
    try_step( sub { $subj = $expr->{func}->($subj) },
      "Expression '$expr->{expr}' failed on '$subj'" );
  }

  # Re-encode to target charset.
  try_step( sub { $subj = $params->{to_charset}{codec}->encode($subj) },
    "Failed to encode '$subj' to $params->{to_charset}{name}" );

  return "$dir$subj$ext";
} ## end sub transform_name


# Check for hard collisions when renaming files.
sub check_hard_collisions {
  my ( $old_names, $new_names ) = @_;
  my $die = 0;
  my %map = ();
  for my $i ( 0 .. scalar @{$new_names} - 1 ) {
    my ( $old, $new ) = ( $old_names->[$i], $new_names->[$i] );
    $map{$new} //= [];
    push @{ $map{$new} }, $old;
  }
  for my $new ( sort keys %map ) {
    next if scalar @{ $map{$new} } == 1;
    my $old = $map{$new};
    say {*STDERR} "Multiple files will be renamed to `$new':";
    say {*STDERR} "  - `$_'" for @{$old};
    $die = 1;
  } ## end for my $new ( sort keys...)
  die "Aborting due to collisions.\n" if $die;
  return;
} ## end sub check_hard_collisions


# Avoid soft collisions when renaming file names.
#
# Returns fresh (old, new) lists plus a set of the temp names it introduced, so
# the caller can render those consistently. Does not mutate its arguments.
#
# Note: $tmpfunc is received as an argument for ease of testing. During normal
# operation, it should not be provided.
sub dodge_soft_collisions {
  my ( $old_names, $new_names, $tmpfunc ) = @_;
  $tmpfunc //= sub {
    my $tmp;
    do {
      my $rnd = join q{}, map { [ '0' .. '9', 'A' .. 'Z', 'a' .. 'z' ]->[ rand(62) ] } 1 .. 8;
      $tmp = "@{[ dirname($_[0]) ]}/@{[ basename($_[0]) =~ s/^(.{0,64}).*/$1/r ]}.$rnd.tmp";
    } while ( -e $tmp );
    return $tmp;
  }; ## end sub
  my @old          = @{$old_names};                 # Copies: leave the caller's lists untouched.
  my @new          = @{$new_names};
  my %seen         = ();
  my %is_temp      = ();                            # Temp names we introduce (for display decoding).
  my @appendix_old = ();
  my @appendix_new = ();
  for my $i ( 0 .. $#new ) {
    my ( $old, $new ) = ( $old[$i], $new[$i] );
    next if $old eq $new;
    $seen{$new} = $i;
    next if not exists $seen{$old};
    my $j   = $seen{$old};
    my $tmp = $tmpfunc->($old);
    $new[$j] = $tmp;
    $is_temp{$tmp} = 1;
    push @appendix_old, $tmp;
    push @appendix_new, $old;
  } ## end for my $i ( 0 .. $#new )
  push @old, @appendix_old;
  push @new, @appendix_new;
  return ( \@old, \@new, \%is_temp );
} ## end sub dodge_soft_collisions


# Create a directory and its parents as needed.
# This is a recursive function similar to 'mkdir -p' in Unix.
sub mkdirp {
  my ($dir) = @_;
  return if -d $dir;                                # Skip if directory already exists
  return if $dir eq q{/};                           # Handle root path edge case
  my $parent = dirname($dir);                       # Get parent directory
  mkdirp($parent) if not -d $parent;                # Create parent directory if it doesn't exist
  mkdir $dir or die "Can't create directory $dir: $OS_ERROR\n";
  -d $dir    or die "Directory $dir doesn't exist after creation attempt\n";
  return;
} ## end sub mkdirp


# Perform the actual file renaming operations.
sub perform_renames {
  my ( $params, $old_names, $new_names, $temp_names ) = @_;

  # Define whether we need to show character set information
  my $show_charset = $params->{from_charset}{name} ne $params->{to_charset}{name};

  for my $i ( 0 .. scalar @{$old_names} - 1 ) {
    my ( $old, $new ) = ( $old_names->[$i], $new_names->[$i] );
    next if $old eq $new;

    # Show progress information if verbosity allows
    if ( $params->{verbosity} > 0 ) {
      # Temp names we introduced are byte-derived from the source (from-charset)
      # names, so decode them with from-charset even though they occupy a target
      # slot; otherwise a charset conversion would mis-render them.
      my $new_charset = ( $temp_names && $temp_names->{$new} )
        ? $params->{from_charset}
        : $params->{to_charset};
      my $old_display = $params->{from_charset}{codec}->decode($old);
      my $new_display = $new_charset->{codec}->decode($new);

      if ($show_charset) {
        say "`$old_display' ($params->{from_charset}{name}) -> `$new_display' ($params->{to_charset}{name})";
      } else {
        say "`$old_display' -> `$new_display'";
      }
    } ## end if ( $params->{verbosity...})

    if ( $params->{apply} ) {
      # Create directory if needed
      my $new_dir = dirname($new);
      mkdirp($new_dir) if $params->{mkdirp} && $new_dir ne q{} && $new_dir ne q{.};

      # Check if source exists
      unless ( -e $old ) {
        die "Source file `$old' does not exist.\n";
      }

      # Check if target exists
      if ( -e $new ) {
        die "Target file `$new' already exists.\n" unless $params->{overwrite};
        unlink $new or die "Can't remove existing target `$new': $OS_ERROR\n";
      }

      # Perform the rename
      rename $old, $new or die "Can't rename `$old' to `$new': $OS_ERROR\n";
    } ## end if ( $params->{apply} )
  } ## end for my $i ( 0 .. scalar...)
  return;
} ## end sub perform_renames


# Main entry point. Returns the process exit code: 0 on success, 1 on failure.
# Errors are reported by die() throughout; catching them here keeps the exit
# code deliberate instead of letting die() leak whatever errno happens to be set.
sub main {
  binmode STDOUT, ':encoding(utf-8)';
  binmode STDERR, ':encoding(utf-8)';

  # Render every failure uniformly. Usage errors raised during argument parsing
  # install their own handler, which additionally points at `--help'; the hint
  # would only mislead for the runtime failures caught here.
  local $SIG{__DIE__} = sub { die format_error( $_[0] ) };

  my $ok = eval {
    my $params = params_get(@ARGV);
    my ( $old_names, $new_names, $temp_names ) = transform_names($params);
    perform_renames( $params, $old_names, $new_names, $temp_names );
    1;
  };
  return 0 if $ok;
  print {*STDERR} $EVAL_ERROR;
  return 1;
} ## end sub main


exit main() unless caller;                          # Run main() if the script is executed directly.


1;
